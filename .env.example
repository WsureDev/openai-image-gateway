GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8188
GATEWAY_PUBLIC_URL=http://127.0.0.1:54160
GATEWAY_STATE_PATH=./data/gateway.sqlite
GATEWAY_PUBLISH_IP=127.0.0.1
GATEWAY_PUBLISH_PORT=54160
GATEWAY_SUBNET=10.253.80.0/24
# Fill two different random values for clients; internal worker traffic has no auth.
GATEWAY_GENERATION_TOKEN=
GATEWAY_MANAGEMENT_TOKEN=
# Optional comma-separated Adapter origins (without /paths).
# GATEWAY_ALLOWED_WORKER_ORIGINS=http://worker-a.example:54162,http://worker-b.example:54162
# Optional build-time networking only; no proxy is added to the running service.
# GATEWAY_BUILD_NETWORK=host
# GATEWAY_BUILD_PROXY=http://127.0.0.1:20171
